{
    "name": "enm1989/chromedriver",
    "description": "Composer distribution of Chromedriver. Installs the right executable for the host platform (linux64, linux-arm64, mac-x64, mac-arm64, win32/win64) at run time.",
    "type": "library",
    "keywords": [
        "selenium",
        "chrome",
        "webdriver",
        "chromedriver"
    ],
    "homepage": "https://github.com/ENM1989/chromedriver",
    "license": "Apache-2.0", 
    "authors": [
        {
            "name": "Nico Müller",
            "email": "nico.mueller.1989@googlemail.com"
        }
    ],
    "config": {
        "bin-dir": "bin"
    },
    "bin": [
        "bin/chromedriver",
        "scripts/update-chromedriver"
    ],
    "scripts": {
        "post-install-cmd": [
            "php scripts/update-chromedriver"
        ],
        "post-update-cmd": [
            "php scripts/update-chromedriver"
        ]
    }
}
